# Copy to .env in the project root and replace the placeholder values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bank_sandbox
DB_USER=berka_user
DB_PASSWORD=replace_with_your_local_password
# Absolute path to the extracted MySQL Connector/J JAR, not its ZIP archive.
JDBC_JAR_PATH=/absolute/path/to/mysql-connector-j.jar
